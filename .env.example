# SovereignSpend Configuration

# PayPal Developer Sandbox Credentials
# Obtain these from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# (Optional) Google Gemini API Key for dynamic multi-modal reasoning
GEMINI_API_KEY=your_gemini_api_key_here

# Note: If no API keys are provided, SovereignSpend automatically runs in
# high-fidelity Simulated Sandbox mode with complete PayPal Order schemas
# and interactive agent reasoning so you can test immediately!
